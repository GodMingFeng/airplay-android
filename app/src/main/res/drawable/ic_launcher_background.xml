<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the launcher icon. The source artwork is a black outline on a transparent
  background, which would be invisible against a dark launcher, so it gets a plate of its own.
  Same gradient as the TV banner, to keep the two looking related.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1565C0"
        android:endColor="#0D253F"
        android:type="linear" />
</shape>
